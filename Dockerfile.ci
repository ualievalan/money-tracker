FROM --platform=linux/amd64 ghcr.io/cirruslabs/flutter:stable

# Install Ruby + build tools (Ruby 3.x comes from noble repos)
RUN apt-get update && apt-get install -y --no-install-recommends \
      ruby-full \
      build-essential \
    && rm -rf /var/lib/apt/lists/*

# Pin Bundler to a version compatible with Ruby 3.x (no `untaint` issue)
RUN gem install bundler -v 2.5.23

# Pre-install Fastlane + Firebase plugin so CI doesn't need to `bundle install`
COPY android/Gemfile android/Gemfile.lock /tmp/fastlane/
RUN cd /tmp/fastlane && bundle install --path vendor/bundle

# Pre-warm pub cache with Flutter itself checked
RUN flutter precache --android

WORKDIR /builds/project
